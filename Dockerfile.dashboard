# The Streamlit dashboard. Reads the run log directly and queues runs through
# the API over HTTP -- it has no Docker access and no Anthropic key.
#
#   docker compose up dashboard      (http://localhost:8501)

FROM python:3.12-slim

WORKDIR /app

# No anthropic SDK: the dashboard never calls the model (it used to be pulled
# in only because .env loading lived in llm.py).
RUN pip install --no-cache-dir "streamlit>=1.50.0" "pandas>=2.2.0" \
    "pymysql>=1.1.0" "python-dotenv>=1.0.0"

COPY src/ ./src/
COPY scripts/dashboard.py ./scripts/dashboard.py

ENV PYTHONUNBUFFERED=1

EXPOSE 8501

CMD ["streamlit", "run", "scripts/dashboard.py", \
     "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
